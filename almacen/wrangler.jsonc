{
  "name": "historico-capturas",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "historico.constitucion.app", "custom_domain": true }],
  "preview_urls": false,
  "r2_buckets": [{ "binding": "CAPTURAS", "bucket_name": "historico-capturas" }],
  "observability": { "enabled": true }
}
